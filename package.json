{
  "name": "snippet-inserter-extension",
  "displayName": "snippet-inserter-extension",
  "description": "Snippet inserter extension for VS Code",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexTheDogg/Snippet-Plugin.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartSnippet.create",
        "title": "Create snippet"
      },
      {
        "command": "smartSnippet.insert",
        "title": "Insert snippet"
      },
      {
        "command": "smartSnippet.delete",
        "title": "Delete snippet"
      },
      {
        "command": "smartSnippet.save",
        "title": "Save snippet"
      },
      {
        "command": "smartSnippet.stats",
        "title": "Show statistics"
      },
      {
        "command": "smartSnippet.list",
        "title": "List snippets"
      },
      {
        "command": "smartSnippet.export",
        "title": "Export snippets"
      },
      {
        "command": "smartSnippet.import",
        "title": "Import snippets"
      }
    ],
    "keybindings": [
      {
        "command": "smartSnippet.create",
        "key": "ctrl+alt+n"
      },
      {
        "command": "smartSnippet.insert",
        "key": "ctrl+shift+i"
      },
      {
        "command": "smartSnippet.delete",
        "key": "ctrl+alt+d"
      },
      {
        "command": "smartSnippet.save",
        "key": "ctrl+alt+s"
      },
      {
        "command": "smartSnippet.stats",
        "key": "ctrl+shift+s"
      },
      {
        "command": "smartSnippet.list",
        "key": "ctrl+alt+x"
      },
      {
        "command": "smartSnippet.export",
        "key": "ctrl+alt+e"
      },
      {
        "command": "smartSnippet.import",
        "key": "ctrl+alt+m"
      }
    ],
    "configuration": {
      "title": "Smart Snippet",
      "properties": {
        "smartSnippet.snippets": {
          "type": "array",
          "default": [],
          "description": "Пользовательские шаблоны кода",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "language": { "type": "array", "items": {"type": "string"} },
              "prefix": { "type": "array", "items": {"type": "string"} },
              "body": { "type": "array", "items": {"type": "string"} },
              "usageCount": { "type": "number" },
              "lastUsed": { "type": "number" },
              "favorite": { "type": "boolean" },
              "categories": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["name", "body"]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
